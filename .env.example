# Synthetic demo database only. Paths are relative to the working directory.
DISPATCH_DATABASE_URL=sqlite:///./data/dispatch.db

# MCP REST adapter. Run uvicorn separately on this loopback address.
DISPATCH_PSA_BASE_URL=http://127.0.0.1:8000

# Default-deny tool writes in BOTH backend and MCP process; restart after changes.
# POST /tickets intake and append-only audit logging are exempt.
DISPATCH_READ_ONLY=true

# Trusted local file path, never supplied by ticket text or tool arguments.
DISPATCH_AUDIT_PATH=./data/audit.jsonl

# Read-only analytics cache paths (trusted configuration, never tool parameters).
# Model artifacts are downloaded on first similarity use; inference stays local.
DISPATCH_EMBEDDING_CACHE_PATH=./data/embeddings.json
DISPATCH_MODEL_CACHE_PATH=./data/models

# Phase 5: choose an OpenAI-compatible Chat Completions endpoint and model.
# Leave blank until choosing; no implicit provider/model fallback.
# BASE_URL includes /v1 when required (e.g. http://127.0.0.1:1234/v1).
# Remote endpoints require HTTPS + API key. Loopback can leave API_KEY empty.
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_TOKENS=2048
# Use max_completion_tokens instead if the selected model requires it.
OPENAI_TOKEN_PARAMETER=max_tokens
# text requests JSON and validates locally; json_object/json_schema require support.
OPENAI_OUTPUT_MODE=text

# Offline DeepEval judge: separate explicit config, even if using the same endpoint.
# Never put real keys in this example file or Git. Live triage never invokes the judge.
DISPATCH_JUDGE_BASE_URL=
DISPATCH_JUDGE_MODEL=
DISPATCH_JUDGE_API_KEY=
DISPATCH_JUDGE_TIMEOUT_SECONDS=120
DISPATCH_JUDGE_MAX_TOKENS=2048
DISPATCH_JUDGE_TOKEN_PARAMETER=max_tokens
DISPATCH_JUDGE_OUTPUT_MODE=text
