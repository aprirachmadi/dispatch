# Synthetic demo database only. Paths are relative to the working directory.
DISPATCH_DATABASE_URL=sqlite:///./data/dispatch.db

# MCP REST adapter. Run uvicorn separately on this loopback address.
DISPATCH_PSA_BASE_URL=http://127.0.0.1:8000

# Default-deny tool writes in BOTH backend and MCP process; restart after changes.
# POST /tickets intake and append-only audit logging are exempt.
DISPATCH_READ_ONLY=true

# Trusted local file path, never supplied by ticket text or tool arguments.
DISPATCH_AUDIT_PATH=./data/audit.jsonl

# Read-only analytics cache paths (trusted configuration, never tool parameters).
# Model artifacts are downloaded on first similarity use; inference stays local.
DISPATCH_EMBEDDING_CACHE_PATH=./data/embeddings.json
DISPATCH_MODEL_CACHE_PATH=./data/models
